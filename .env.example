# ----------------------------------------------------------------------------
# Pearls AQI Predictor - environment configuration
#
# Copy this file to `.env` and fill in the values you need.
# Nothing here is required to run the project locally: by default the app
# runs against the free, key-less Open-Meteo API and a local on-disk feature
# store / model registry, so it works the moment you `pip install`.
#
# Everything below is OPTIONAL and lets you upgrade individual pieces of the
# stack to their managed / hosted equivalents without changing any code.
# ----------------------------------------------------------------------------

# --- Data source ------------------------------------------------------------
# "open_meteo" (default, free, no key, used for weather + AQI) or "openweather"
AQI_DATA_PROVIDER=open_meteo

# Only needed if AQI_DATA_PROVIDER=openweather
# Get a free key at https://openweathermap.org/api
OPENWEATHER_API_KEY=

# --- Feature store / model registry -----------------------------------------
# "local" (default, Parquet files under data/local_store/, zero setup) or
# "hopsworks" (managed, free tier, matches the project brief's suggested
# serverless architecture).
FEATURE_STORE_BACKEND=local

# Only needed if FEATURE_STORE_BACKEND=hopsworks
# Create a free project at https://app.hopsworks.ai and generate an API key
# under Account Settings -> API Keys.
HOPSWORKS_API_KEY=
HOPSWORKS_PROJECT_NAME=

# --- Alerting (optional) -----------------------------------------------------
# If set, the alerts module will additionally POST hazardous-AQI alerts to
# this Slack Incoming Webhook URL. Leave blank to only show in-app alerts.
SLACK_WEBHOOK_URL=

# --- Misc ---------------------------------------------------------------
# Logging verbosity: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
